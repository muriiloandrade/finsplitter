{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": "Renovate configuration for Finsplitter - A personal finance control application",
    "extends": [
        "config:recommended",
        "docker:pinDigests",
        "helpers:pinGitHubActionDigests",
        "schedule:daily",
        "schedule:automergeNonOfficeHours",
        ":label(dependencies)",
        ":assignee(@muriiloandrade)",
        ":timezone(America/Sao_Paulo)",
        ":prConcurrentLimit10",
        ":enableVulnerabilityAlerts",
        ":automergeStableNonMajor",
        "customManagers:dockerfileVersions",
        "customManagers:makefileVersions"
    ],
    "postUpdateOptions": [
        "gomodTidy",
        "gomodUpdateImportPaths"
    ],
    "prConcurrentLimit": 5,
    "packageRules": [
        {
            "description": "Group all Go dependencies together",
            "groupName": "golang dependencies",
            "matchManagers": [
                "gomod"
            ]
        },
        {
            "description": "Group Docker base images",
            "groupName": "docker base images",
            "matchPackageNames": [
                "golang",
                "postgres",
                "gcr.io/distroless/static-debian12"
            ]
        },
        {
            "description": "Group Docker dev tools used in Makefile",
            "groupName": "docker dev tools",
            "matchPackageNames": [
                "migrate/migrate",
                "sqlc/sqlc",
                "vektra/mockery",
                "golangci/golangci-lint"
            ]
        },
        {
            "description": "Require Go version >= 1.24",
            "matchManagers": [
                "gomod"
            ],
            "matchPackageNames": [
                "go"
            ],
            "allowedVersions": ">=1.24"
        }
    ],
    "platformAutomerge": true
}