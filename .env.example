# ============================================================
# Go Build Configuration
# ============================================================
# jwx/v4 depends on encoding/json/v2 which requires GOEXPERIMENT=jsonv2.
# Set this in your shell or IDE to avoid "build constraints exclude all Go
# files" errors in gopls:
#   export GOEXPERIMENT=jsonv2
# ============================================================
# Database Configuration
# ============================================================
PG_URL=postgres://<username>:<password>@host.docker.internal:5432/<database>?sslmode=<disable|require|verify-full|verify-ca>&application_name=<app_name>
PG_DB=
PG_PORT=5432
PG_HOST=host.docker.internal
PG_USER=
PG_PASS=
PG_SSL_MODE=disable
PG_SCHEMA=public

PG_MAX_CONNS=10
PG_MIN_CONNS=1
PG_MAX_CONN_LIFETIME=1h
PG_MAX_CONN_IDLE_TIME=10m
PG_HEALTH_CHECK_PERIOD=1m
PG_CONNECT_TIMEOUT=15s

# ============================================================
# Valkey / Redis Configuration
# ============================================================
REDIS_URL=redis://host.docker.internal:6379/0
VALKEY_PORT=6379

# ============================================================
# App Configuration
# ============================================================
APP_PORT=3033
APP_NAME=finsplitter
APP_VERSION=development
DEBUGGER_PORT=9399

ENV_NAME=development
LOG_FORMAT=text # or "json"

# ============================================================
# OpenTelemetry Configuration
# ============================================================
OTEL_ENABLED=false
OTEL_SERVICE_NAME=finsplitter
OTEL_EXPORTER_OTLP_ENDPOINT=host.docker.internal:4318
OTEL_EXPORTER_INSECURE=true
OTEL_ENABLE_TRACES=true
OTEL_ENABLE_METRICS=true
OTEL_ENABLE_LOGS=true
OTEL_SAMPLER_RATIO=1.0
OTEL_EXPORT_INTERVAL=500ms
OTEL_EXPORTER_TIMEOUT=5s
OTEL_METRIC_EXPORT_INTERVAL=500

# ============================================================
# Logto Configuration
# ============================================================
LOGTO_PORT=3001
LOGTO_PORT_MGMT=3002
# Logto shares the same PostgreSQL instance as the app
# The database "logto" is created automatically by Logto's db seed
LOGTO_DB_URL=postgres://${PG_USER}:${PG_PASS}@${PG_HOST}:${PG_PORT}/logto?sslmode=disable&application_name=logto
LOGTO_ENDPOINT=http://localhost:3001
LOGTO_ADMIN_ENDPOINT=http://localhost:3002

# M2M App Credentials (bootstrap only — run scripts/setup-m2m.sh after first startup)
LOGTO_MGMT_CLIENT_ID=
LOGTO_MGMT_CLIENT_SECRET=
# Management API resource indicator — defaults to LOGTO_ENDPOINT/api
# Find the correct value in Logto Console > API Resources > Management API > indicator
LOGTO_MGMT_API_RESOURCE=

# ============================================================
# App Auth Configuration
# ============================================================
# Logto OIDC endpoint for JWKS fetching and token validation
LOGTO_OIDC_ENDPOINT=${LOGTO_ENDPOINT}/oidc
# Expected OIDC issuer (iss claim) — separate from OIDC_ENDPOINT for Docker networking
LOGTO_ISSUER=${LOGTO_ENDPOINT}/oidc
LOGTO_APP_CLIENT_ID=          # The "Traditional" app client ID for user auth (created via Logto Console)
LOGTO_APP_CLIENT_SECRET=      # The "Traditional" app client secret
LOGTO_JWT_ALG=RS256           # Logto uses RS256 by default
