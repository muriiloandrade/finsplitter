PG_URL=postgres://<username>:<password>@host.docker.internal:5432/<database>?sslmode=<disable|require|verify-full|verify-ca>&application_name=<app_name>
PG_DB=
PG_PORT=5432
PG_HOST=host.docker.internal
PG_USER=
PG_PASS=
PG_SSL_MODE=disable
PG_SCHEMA=public

PG_MAX_CONNS=10
PG_MIN_CONNS=1
PG_MAX_CONN_LIFETIME=1h
PG_MAX_CONN_IDLE_TIME=10m
PG_HEALTH_CHECK_PERIOD=1m
PG_CONNECT_TIMEOUT=15s

APP_PORT=3033
APP_NAME=finsplitter
APP_VERSION=development

ENV_NAME=development
LOG_FORMAT=text # or "json"

# OpenTelemetry Configuration
OTEL_ENABLED=true
OTEL_SERVICE_NAME=finsplitter
OTEL_EXPORTER_OTLP_ENDPOINT=host.docker.internal:4318
OTEL_EXPORTER_INSECURE=true
OTEL_ENABLE_TRACES=true
OTEL_ENABLE_METRICS=true
OTEL_ENABLE_LOGS=true
OTEL_SAMPLER_RATIO=1.0
OTEL_EXPORT_INTERVAL=30s
OTEL_EXPORTER_TIMEOUT=5s